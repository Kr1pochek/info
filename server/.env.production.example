NODE_ENV=production
PORT=4000

DATABASE_URL=postgresql://dgd_app:replace_with_strong_database_password@127.0.0.1:5432/dgd_infokiosk
CLIENT_URL=http://127.0.0.1:4000

JWT_ACCESS_SECRET=replace_with_at_least_32_random_characters
JWT_REFRESH_SECRET=replace_with_another_32_character_secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
SHUTDOWN_GRACE_MS=10000
RATE_LIMIT_WINDOW_MS=60000
PUBLIC_RATE_LIMIT=1200
ADMIN_RATE_LIMIT=300
AUTH_RATE_LIMIT=30

# Для одного правила доступа используйте api-ninjas и укажите рабочий API-ключ.
INFORMER_PROVIDER=api-ninjas
API_NINJAS_KEY=replace_with_api_ninjas_key

SEED_ADMIN_LOGIN=admin
SEED_ADMIN_PASSWORD=replace_with_a_unique_admin_password
SEED_ADMIN_NAME=Главный администратор
SEED_ADMIN_RESET_PASSWORD=false
