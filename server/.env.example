NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://postgres:password@127.0.0.1:5433/dgd_infokiosk
CLIENT_URL=http://localhost:5174

JWT_ACCESS_SECRET=replace_with_at_least_32_random_characters
JWT_REFRESH_SECRET=replace_with_at_least_32_random_characters
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
SHUTDOWN_GRACE_MS=10000
RATE_LIMIT_WINDOW_MS=60000
PUBLIC_RATE_LIMIT=1200
ADMIN_RATE_LIMIT=300
AUTH_RATE_LIMIT=30
TRUST_PROXY_HOPS=0

# official: nationalbank.kz + api.open-meteo.com (для локальной проверки)
# api-ninjas: один внешний домен api.api-ninjas.com (для закрытого хоста)
INFORMER_PROVIDER=official
API_NINJAS_KEY=

SEED_ADMIN_LOGIN=admin
SEED_ADMIN_PASSWORD=change_me
SEED_ADMIN_NAME=Главный администратор
SEED_ADMIN_RESET_PASSWORD=false
