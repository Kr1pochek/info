{
  "name": "dgd-infokiosk",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install:all": "npm install && npm install --prefix client && npm install --prefix server",
    "dev": "concurrently -n CLIENT,SERVER -c cyan,blue \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "npm run dev --prefix client",
    "dev:server": "npm run dev --prefix server",
    "start": "npm run start --prefix server",
    "doctor": "node scripts/doctor.mjs",
    "release:check": "npm run verify && node scripts/doctor.mjs --production",
    "db:migrate": "npm run db:migrate --prefix server",
    "db:deploy": "npm run db:deploy --prefix server",
    "db:seed": "npm run db:seed --prefix server",
    "db:studio": "npm run db:studio --prefix server",
    "build": "npm run build --prefix client",
    "lint": "npm run lint --prefix client && npm run lint --prefix server",
    "test": "npm run test --prefix server && node --test tests/search-suggestions.test.mjs tests/inactivity.test.mjs",
    "test:tts": "node --test tests/tts.test.mjs",
    "test:responsive": "node tests/responsive.mjs",
    "security:check": "npm audit --omit=dev && npm audit --omit=dev --prefix client && npm audit --omit=dev --prefix server",
    "tts:dry-run": "node scripts/tts/generate.mjs --dry-run",
    "tts:generate": "node scripts/tts/generate.mjs",
    "tts:premium": "node scripts/tts/generate-premium-voiceovers.mjs",
    "tts:elevenlabs": "node scripts/tts/generate-elevenlabs-voice-trio.mjs",
    "tts:elevenlabs:design": "node scripts/tts/generate-elevenlabs-voice-trio.mjs --design",
    "tts:elevenlabs:kk-variants": "node scripts/tts/generate-elevenlabs-voice-trio.mjs --kazakh-variants",
    "tts:variants": "node scripts/tts/generate-voice-variants.mjs",
    "tts:trio": "node scripts/tts/prepare-matched-voice-trio.mjs",
    "tts:kk:silero": "node scripts/tts/generate-silero-kazakh.mjs",
    "tts:kk:silero:final": "node scripts/tts/generate-silero-kazakh.mjs --final",
    "tts:install": "py -m pip install -r scripts/tts/requirements.txt",
    "tts:compose": "node scripts/tts/compose.mjs",
    "verify": "npm run lint && npm run build && npm test && npm run test:tts && npm run test:responsive"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "playwright-core": "^1.62.1"
  },
  "engines": {
    "node": ">=20"
  }
}
